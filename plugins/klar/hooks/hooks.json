{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Read|Bash|PowerShell|Grep|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook/hook.js\"",
            "timeout": 12
          }
        ]
      }
    ]
  }
}
